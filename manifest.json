{
  "manifest_version": 3,
  "name": "PDD Local Publisher",
  "version": "0.1.1",
  "description": "本地导入商品数据并辅助填写拼多多商家后台发布页面，不使用 AI。",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["storage", "tabs", "activeTab", "scripting", "downloads"],
  "host_permissions": [
    "https://mms.pinduoduo.com/*",
    "https://*.pinduoduo.com/*",
    "https://*.yangkeduo.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "PDD Local Publisher",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png"
    },
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mms.pinduoduo.com/*"],
      "js": ["shared/storage.js", "content/content-script.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
